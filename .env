# Base URL for the MokaCo HRMS API.
# Leave this empty during development: requests go to a relative "/api/..." path
# and the Vite dev proxy (see vite.config.ts) forwards them to the backend,
# avoiding CORS and the self-signed HTTPS certificate.
# For production builds, set this to the deployed API origin, e.g.
#   VITE_API_BASE_URL=https://hrms.mokaco.com
VITE_API_BASE_URL=
